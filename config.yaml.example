# QobuzConnectLMS configuration
# Copy to config.yaml and fill in your details.
#
# Authentication: open http://localhost:8689 and click "Log in to Qobuz".
# The token is cached automatically — no credentials live in this file.

qobuz:
  max_quality: 27               # 5=MP3, 6=CD, 7=Hi-Res 96k, 27=Hi-Res 192k

  # Power-user alternative: skip the web UI by pasting a pre-obtained token.
  # user_id: "12345678"
  # auth_token: "your-auth-token"

server:
  http_port: 8689               # Web UI (login, status)
  bind_address: "0.0.0.0"       # Network interface to bind

logging:
  level: "info"                 # debug, info, warning, error

# --- Speakers ---
# Each speaker appears as a separate Qobuz Connect device in the Qobuz app.
# Ports are auto-assigned unless specified (http_port).
speakers:
  # One entry per LMS player you want to expose.
  - name: "Living Room (LMS)"   # Name shown in the Qobuz app
    backend: lms
    lms_host: "192.168.1.10"    # LMS server address
    lms_port: 9000              # LMS web/JSON-RPC port
    lms_player: "00:11:22:33:44:55"  # Player MAC address, or its exact LMS name

  # - name: "Kitchen (LMS)"
  #   backend: lms
  #   lms_host: "192.168.1.10"
  #   lms_player: "Kitchen"

  # The upstream qobuz-proxy backends are still available:
  # - name: "Sonos"
  #   backend: dlna
  #   dlna_ip: "192.168.1.50"
  #   max_quality: auto
  #
  # - name: "Headphones"
  #   backend: local              # Requires: pip install .[local]
  #   audio_device: "Built-in Output"
