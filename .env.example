# QobuzProxy Docker Environment Variables
# Copy this file to .env and fill in your values

# Authentication
# The web UI at http://localhost:8689 is the primary auth method (OAuth login).
# These env vars are a power-user alternative for headless setups — paste a
# pre-obtained token instead of logging in via the browser.
# QOBUZ_USER_ID=your-user-id
# QOBUZ_AUTH_TOKEN=your-auth-token

# Optional: Audio quality
# 5 = MP3 320kbps
# 6 = FLAC CD Quality (16-bit/44.1kHz)
# 7 = FLAC Hi-Res (24-bit/96kHz)
# 27 = FLAC Hi-Res Max (24-bit/192kHz)
QOBUZ_MAX_QUALITY=27

# Optional: Device name shown in Qobuz app
QOBUZPROXY_DEVICE_NAME=QobuzProxy

# Backend type: "lms", "dlna" or "local"
QOBUZPROXY_BACKEND=lms

# LMS backend settings (when using backend type "lms")
QOBUZPROXY_LMS_HOST=192.168.1.10
QOBUZPROXY_LMS_PORT=9000
# Player MAC address or exact LMS player name
QOBUZPROXY_LMS_PLAYER=00:11:22:33:44:55
# LMS CLI port for change events (0 = polling only)
# QOBUZPROXY_LMS_CLI_PORT=9090

# DLNA backend settings (when using backend type "dlna")
# QOBUZPROXY_DLNA_IP=192.168.1.50
# QOBUZPROXY_DLNA_PORT=1400
# QOBUZPROXY_DLNA_FIXED_VOLUME=false
# QOBUZPROXY_PROXY_PORT=7120

# Local audio backend settings (when using backend type "local")
# QOBUZPROXY_AUDIO_DEVICE=default
# QOBUZPROXY_AUDIO_BUFFER_SIZE=2048

# Optional: Server port
QOBUZPROXY_HTTP_PORT=8689

# Optional: Log level (debug, info, warning, error)
QOBUZPROXY_LOG_LEVEL=info

# --- Multi-Speaker Configuration (comma-separated) ---
# When QOBUZPROXY_DEVICE_NAME contains commas, multiple speakers are created.
# Each env var is split by comma; single values broadcast to all speakers.
#
# QOBUZPROXY_DEVICE_NAME=Living Room,Kitchen
# QOBUZPROXY_BACKEND=lms
# QOBUZPROXY_LMS_HOST=192.168.1.10
# QOBUZPROXY_LMS_PLAYER=00:11:22:33:44:55,Kitchen
#
# Ports are auto-assigned (8689+, 7120+) unless specified:
# QOBUZPROXY_HTTP_PORT=8689,8690
# QOBUZPROXY_PROXY_PORT=7120,7121
